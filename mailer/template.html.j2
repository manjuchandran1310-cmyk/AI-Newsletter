<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="color-scheme" content="light dark" />
  <meta name="supported-color-schemes" content="light dark" />
  <title>AI Newsletter — {{ date }}</title>
  <!--[if mso]>
  <noscript>
    <xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml>
  </noscript>
  <![endif]-->
  <style>
    @media (prefers-color-scheme: dark) {
      .body-bg    { background-color: #111111 !important; }
      .wrapper    { background-color: #1a1a1a !important; }
      .ink        { color: #f3f4f6 !important; }
      .body-text  { color: #d1d5db !important; }
      .muted-text { color: #a1a1aa !important; }
      .rule-strong { border-color: #e5e7eb !important; }
      .rule       { border-color: #333333 !important; }
      .link-color { color: #93c5fd !important; }
    }
  </style>
</head>
<body class="body-bg" style="margin:0;padding:0;background-color:#f3f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">

  <!-- Preheader (hidden) -->
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">
    Your AI briefing for {{ date }} — top picks from across the ecosystem.&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;
  </div>

  <!-- Outer wrapper -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#f3f4f6;" class="body-bg">
    <tr>
      <td align="center" style="padding:24px 12px;">

        <!-- Inner card — max 600px -->
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
               style="max-width:600px;background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.1);"
               class="wrapper">
          <tr>
            <td style="padding:0 40px;">

              <!-- ═══════════════ HEADER ═══════════════ -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td class="rule-strong" style="padding:30px 0 16px;border-bottom:2px solid #111827;">
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                      <tr>
                        <td valign="bottom">
                          <h1 class="ink" style="margin:0;font-size:28px;font-weight:800;line-height:1.2;letter-spacing:-0.02em;color:#111827;">AI Newsletter</h1>
                        </td>
                        <td valign="bottom" align="right">
                          <p class="muted-text" style="margin:0;font-size:14px;color:#4b5563;white-space:nowrap;">{{ date }}</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td style="padding:14px 0 0;">
                    <p class="body-text" style="margin:0;font-size:15px;line-height:1.55;color:#374151;">What matters in AI today, ranked by relevance.</p>
                  </td>
                </tr>
              </table>

              <!-- ═══════════════ TOP STORY ═══════════════ -->
              {% if top_story %}
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td class="rule" style="padding:22px 0 26px;border-bottom:1px solid #e5e7eb;">
                    <p class="muted-text" style="margin:0 0 8px;font-size:13px;color:#4b5563;">
                      <strong class="ink" style="color:#111827;">Top story</strong> &nbsp;·&nbsp; {{ top_story.source }} &nbsp;·&nbsp; {{ top_story.relevance_score }}/10
                    </p>
                    <h2 style="margin:0 0 10px;font-size:23px;font-weight:700;line-height:1.3;letter-spacing:-0.01em;">
                      <a href="{{ top_story.url }}" class="ink" style="color:#111827;text-decoration:none;">{{ top_story.title }}</a>
                    </h2>
                    <p class="body-text" style="margin:0;font-size:15px;line-height:1.6;color:#374151;">{{ top_story.summary }}</p>
                    {% if top_story.why_it_matters %}
                    <p class="body-text" style="margin:10px 0 0;font-size:15px;line-height:1.6;color:#374151;">
                      <strong class="ink" style="color:#111827;">Why it matters:</strong> {{ top_story.why_it_matters }}
                    </p>
                    {% endif %}
                    <p style="margin:12px 0 0;font-size:14px;">
                      <a href="{{ top_story.url }}" class="link-color" style="color:#1d4ed8;text-decoration:underline;">Read the full story</a>
                    </p>
                  </td>
                </tr>
              </table>
              {% endif %}

              <!-- ═══════════════ TRENDING TOPICS ═══════════════ -->
              {% if trending_topics %}
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td class="rule" style="padding:18px 0;border-bottom:1px solid #e5e7eb;">
                    <p class="body-text" style="margin:0;font-size:14px;line-height:1.6;color:#374151;">
                      <strong class="ink" style="color:#111827;">Trending this week:</strong>
                      {% for t in trending_topics[:6] %}{{ t.topic }}{% if t.article_count %} ({{ t.article_count }}){% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
                    </p>
                  </td>
                </tr>
              </table>
              {% endif %}

              <!-- ═══════════════ SECTIONS ═══════════════ -->
              {% set sections = [
                ("Artificial intelligence", ai_articles, true, true),
                ("Product and design", product_articles, true, false),
                ("Funding and business", funding_articles, false, false),
                ("From the community", community_articles, false, false),
              ] %}
              {% for heading, items, scored, show_why in sections %}
              {% if items %}
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td class="rule-strong" style="padding:26px 0 8px;border-bottom:1px solid #111827;">
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                      <tr>
                        <td valign="bottom">
                          <h3 class="ink" style="margin:0;font-size:18px;font-weight:700;color:#111827;">{{ heading }}</h3>
                        </td>
                        <td valign="bottom" align="right">
                          <p class="muted-text" style="margin:0;font-size:13px;color:#4b5563;">{{ items|length }} {{ "story" if items|length == 1 else "stories" }}</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                {% for article in items %}
                <tr>
                  <td class="rule" style="padding:16px 0;border-bottom:1px solid #e5e7eb;">
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                      <tr>
                        <td valign="top">
                          <h4 style="margin:0 0 4px;font-size:16px;font-weight:600;line-height:1.4;">
                            <a href="{{ article.url }}" class="ink" style="color:#111827;text-decoration:none;">{{ article.title }}</a>
                          </h4>
                          {% if article.one_liner %}
                          <p class="body-text" style="margin:0;font-size:14px;line-height:1.55;color:#374151;">{{ article.one_liner }}</p>
                          {% endif %}
                          {% if article.why_it_matters and show_why %}
                          <p class="body-text" style="margin:6px 0 0;font-size:14px;line-height:1.55;color:#374151;">
                            <strong class="ink" style="color:#111827;">Why it matters:</strong> {{ article.why_it_matters }}
                          </p>
                          {% endif %}
                          <p class="muted-text" style="margin:6px 0 0;font-size:13px;color:#4b5563;">{{ article.source }}</p>
                        </td>
                        {% if scored and article.relevance_score %}
                        <td valign="top" align="right" width="56" style="padding-left:16px;white-space:nowrap;">
                          <p class="ink" style="margin:0;font-size:15px;font-weight:700;color:#111827;">{{ article.relevance_score }}<span class="muted-text" style="font-size:12px;font-weight:400;color:#4b5563;">/10</span></p>
                        </td>
                        {% endif %}
                      </tr>
                    </table>
                  </td>
                </tr>
                {% endfor %}
              </table>
              {% endif %}
              {% endfor %}

              <!-- ═══════════════ FOOTER ═══════════════ -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td style="height:26px;line-height:26px;font-size:0;">&nbsp;</td>
                </tr>
                <tr>
                  <td class="rule-strong" style="padding:20px 0 28px;border-top:2px solid #111827;">
                    <p class="muted-text" style="margin:0 0 8px;font-size:13px;line-height:1.6;color:#4b5563;">
                      You're receiving this because you subscribed to the AI Newsletter.
                      Powered by Gemini API, Neo4j AuraDB and Resend.
                    </p>
                    <p class="muted-text" style="margin:0;font-size:13px;color:#4b5563;">
                      <a href="mailto:unsubscribe@example.com?subject=unsubscribe" class="link-color" style="color:#1d4ed8;text-decoration:underline;">Unsubscribe</a>
                      &nbsp;·&nbsp;
                      <a href="mailto:feedback@example.com" class="link-color" style="color:#1d4ed8;text-decoration:underline;">Send feedback</a>
                      &nbsp;·&nbsp; {{ date }}
                    </p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>
        </table>
        <!-- /inner card -->

      </td>
    </tr>
  </table>
  <!-- /outer wrapper -->

</body>
</html>
